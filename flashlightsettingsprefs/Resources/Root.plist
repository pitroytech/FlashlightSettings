        <key>cell</key>
        <string>PSGroupCell</string>
        <key>footerText</key>
        <string>"Keep Screen Off" puts the screen back off when a button shortcut fires while the phone is asleep, so the flashlight toggles without waking the phone. The screen may still flash for a moment.</string>
      </dict>

